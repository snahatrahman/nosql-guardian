{
  "info": {
    "name": "NoSQL Guardian - Attack Test Collection",
    "description": "Demonstrates NoSQL injection attacks against /api/auth/login, both without protection (baseline) and with the NoSQL Guardian middleware blocking them.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Normal Login (should succeed)",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"admin\",\n  \"password\": \"SuperSecret123!\"\n}"
        },
        "url": { "raw": "http://localhost:5000/api/auth/login", "host": ["localhost"], "port": "5000", "path": ["api", "auth", "login"] }
      }
    },
    {
      "name": "2. Attack - $ne bypass (should be blocked)",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"admin\",\n  \"password\": { \"$ne\": null }\n}"
        },
        "url": { "raw": "http://localhost:5000/api/auth/login", "host": ["localhost"], "port": "5000", "path": ["api", "auth", "login"] }
      }
    },
    {
      "name": "3. Attack - $where injection (should be blocked, high risk)",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"admin\",\n  \"password\": { \"$where\": \"this.password.length > 0\" }\n}"
        },
        "url": { "raw": "http://localhost:5000/api/auth/login", "host": ["localhost"], "port": "5000", "path": ["api", "auth", "login"] }
      }
    },
    {
      "name": "4. Attack - nested $or (should be blocked, recursive detection)",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"admin\",\n  \"password\": { \"$or\": [{ \"$gt\": \"\" }, { \"$eq\": \"\" }] }\n}"
        },
        "url": { "raw": "http://localhost:5000/api/auth/login", "host": ["localhost"], "port": "5000", "path": ["api", "auth", "login"] }
      }
    },
    {
      "name": "5. False positive check - $ inside a normal string (should succeed/401, not blocked)",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"admin\",\n  \"password\": \"Pass$word123\"\n}"
        },
        "url": { "raw": "http://localhost:5000/api/auth/login", "host": ["localhost"], "port": "5000", "path": ["api", "auth", "login"] }
      }
    }
  ]
}